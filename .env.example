# =========================================================================
# LuxeStay - Server Environment Variables Template
# =========================================================================

# Server Port
PORT=5000

# Environment Mode (development / production)
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/hotel_db?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=luxestay_jwt_secret_key_change_me_2026

# Optional: Stripe Gateway Keys
STRIPE_TEST_SK=sk_test_51...
STRIPE_LIVE_SK=sk_live_51...

# Optional: PayPal REST API Keys
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Optional: Razorpay Keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
