# Server Configuration
PORT=5000

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your actual MongoDB Atlas database credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/hotel_db?retryWrites=true&w=majority

# Stripe Payment Gateway Test Keys (Optional)
STRIPE_TEST_PK=pk_test_your_stripe_publishable_key_here
STRIPE_TEST_SK=sk_test_your_stripe_secret_key_here
